"""
All models - aligned with schemas
"""
from sqlalchemy import Column, Integer, String, Numeric, DateTime, Text, BigInteger, ForeignKey
from sqlalchemy import JSON
from backend.database import Base, TimestampMixin


class Customer(TimestampMixin, Base):
    __tablename__ = "customers"
    id = Column(Integer, primary_key=True)
    name = Column(String(200), nullable=False)
    contact_person = Column(String(100))
    phone = Column(String(50))
    email = Column(String(100))
    payment_terms = Column(String(100))
    payment_days = Column(Integer)
    address = Column(String(500))


class Foundry(TimestampMixin, Base):
    __tablename__ = "foundries"
    id = Column(Integer, primary_key=True)
    name = Column(String(200), nullable=False)
    contact_person = Column(String(100))
    phone = Column(String(50))
    address = Column(String(500))
    customer_id = Column(Integer, ForeignKey("customers.id"), nullable=False)
    images = Column(JSON, default=list)


class Casting(TimestampMixin, Base):
    __tablename__ = "castings"
    id = Column(Integer, primary_key=True)
    part_number = Column(String(100), nullable=False)
    name = Column(String(200), nullable=False)
    description = Column(String(500))
    customer_id = Column(Integer, ForeignKey("customers.id"), nullable=False)
    images = Column(JSON, default=list)


class PartDrawing(TimestampMixin, Base):
    __tablename__ = "part_drawings"
    id = Column(Integer, primary_key=True)
    casting_id = Column(Integer, ForeignKey("castings.id"), nullable=False)
    drawing_number = Column(String(100), nullable=False)
    version = Column(String(50))
    description = Column(String(500))
    file_path = Column(String(500))
    update_date = Column(DateTime)


class CastingIn(TimestampMixin, Base):
    __tablename__ = "casting_ins"
    id = Column(Integer, primary_key=True)
    delivery_note_no = Column(String(100), nullable=False, unique=True)
    foundry_id = Column(Integer, ForeignKey("foundries.id"), nullable=False)
    casting_id = Column(Integer, ForeignKey("castings.id"), nullable=False)
    quantity = Column(Numeric(10, 2), nullable=False)
    unit_price = Column(Numeric(10, 2), nullable=False)
    incoming_date = Column(DateTime, nullable=False)
    delivery_date = Column(DateTime)
    received_by = Column(String(100))
    status = Column(String(50), default="pending")
    notes = Column(String(500))
    images = Column(JSON, default=list)


class WorkpieceOut(TimestampMixin, Base):
    __tablename__ = "workpiece_outs"
    id = Column(Integer, primary_key=True)
    delivery_note_no = Column(String(100), nullable=False, unique=True)
    customer_id = Column(Integer, ForeignKey("customers.id"), nullable=False)
    casting_id = Column(Integer, ForeignKey("castings.id"), nullable=False)
    quantity = Column(Numeric(10, 2), nullable=False)
    unit_price = Column(Numeric(10, 2), nullable=False)
    delivery_date = Column(DateTime)
    shipping_address = Column(String(500))
    status = Column(String(50), default="pending")
    notes = Column(String(500))
    images = Column(JSON, default=list)


class ProductionPlan(TimestampMixin, Base):
    __tablename__ = "production_plans"
    id = Column(Integer, primary_key=True)
    plan_no = Column(String(100), nullable=False, unique=True)
    customer_id = Column(Integer, ForeignKey("customers.id"), nullable=False)
    casting_id = Column(Integer, ForeignKey("castings.id"), nullable=False)
    required_quantity = Column(Numeric(15, 3), nullable=False)
    produced_quantity = Column(Numeric(15, 3), nullable=False, default=0)
    start_date = Column(DateTime)
    due_date = Column(DateTime, nullable=False)
    status = Column(String(50), default="pending")
    notes = Column(String(500))
    images = Column(JSON, default=list)


class PaymentPlan(TimestampMixin, Base):
    __tablename__ = "payment_plans"
    id = Column(Integer, primary_key=True)
    customer_id = Column(Integer, ForeignKey("customers.id"), nullable=False)
    workpiece_out_id = Column(Integer, ForeignKey("workpiece_outs.id"), nullable=False)
    expected_date = Column(DateTime, nullable=False)
    actual_date = Column(DateTime)
    amount = Column(Numeric(15, 2), nullable=False)
    status = Column(String(50), default="pending")
    payment_method = Column(String(100))
    notes = Column(String(500))


class QualityIssue(TimestampMixin, Base):
    __tablename__ = "quality_issues"
    id = Column(Integer, primary_key=True)
    customer_id = Column(Integer, ForeignKey("customers.id"), nullable=False)
    workpiece_out_id = Column(Integer, ForeignKey("workpiece_outs.id"))
    casting_id = Column(Integer, ForeignKey("castings.id"), nullable=False)
    issue_type = Column(String(100), nullable=False)
    description = Column(Text, nullable=False)
    severity = Column(String(50), default="medium")
    status = Column(String(50), default="open")
    resolution = Column(Text)
    notes = Column(String(500))
    resolved_at = Column(DateTime)


class Attachment(TimestampMixin, Base):
    __tablename__ = "attachments"
    id = Column(Integer, primary_key=True)
    entity_type = Column(String(50), nullable=False)
    entity_id = Column(Integer, nullable=False)
    file_path = Column(String(500), nullable=False)
    file_name = Column(String(255), nullable=False)
    file_size = Column(BigInteger)
    mime_type = Column(String(100))
    description = Column(String(500))


class QualityCheck(TimestampMixin, Base):
    __tablename__ = "quality_checks"
    id = Column(Integer, primary_key=True)
    casting_id = Column(Integer, ForeignKey("castings.id"), nullable=False)
    check_date = Column(DateTime, nullable=False)
    inspector = Column(String(100))
    result = Column(String(50), default="pending")
    quantity_checked = Column(Numeric(10, 2))
    quantity_passed = Column(Numeric(10, 2))
    notes = Column(String(500))


class ProductionOperation(TimestampMixin, Base):
    __tablename__ = "production_operations"
    id = Column(Integer, primary_key=True)
    casting_id = Column(Integer, ForeignKey("castings.id"), nullable=False)
    process_name = Column(String(200), nullable=False)
    operation_date = Column(DateTime, nullable=False)
    operator = Column(String(100))
    quantity = Column(Numeric(10, 2), nullable=False)
    status = Column(String(50), default="pending")
    notes = Column(String(500))


class ProcessRoute(TimestampMixin, Base):
    __tablename__ = "process_routes"
    id = Column(Integer, primary_key=True)
    casting_id = Column(Integer, ForeignKey("castings.id"), nullable=False)
    process_name = Column(String(200), nullable=False)
    sequence = Column(Integer, nullable=False)
    description = Column(String(500))
    standard_time = Column(Numeric(10, 2))


class Technology(TimestampMixin, Base):
    __tablename__ = "technologies"
    id = Column(Integer, primary_key=True)
    name = Column(String(200), nullable=False)
    description = Column(Text)
    category = Column(String(100))
    parameters = Column(Text)
    status = Column(String(50), default="active")


# Backward compatibility aliases - for code that still uses old names
Supplier = Foundry
Part = Casting
MaterialIn = CastingIn
ProductOut = WorkpieceOut